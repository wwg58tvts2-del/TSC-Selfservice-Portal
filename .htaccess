# Entfernt die sichtbare .html-Endung aus allen Aufrufen des Portals
# (index.html, kalender.html, trainingsplan.html) und blendet die
# Verzeichnisauflistung aus. Wirkt nur unter Apache/LiteSpeed mit
# aktiviertem mod_rewrite und AllowOverride All.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Verhindert, dass Apache ohne diese Regeln selbst schon "schoene" URLs
  # ausliefert und damit die folgenden Regeln umgeht.
  Options -Indexes -MultiViews

  # Stellt sicher, dass "/" immer index.html zeigt, unabhaengig von der
  # serverweiten Standardeinstellung (z. B. falls dort index.php zuerst steht).
  DirectoryIndex index.html

  # /index.html immer auf den Seitenstamm umleiten (sichtbare Adresse "/").
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.html[?\s] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # Jeden Aufruf mit sichtbarer .html-Endung auf die Version ohne Endung
  # umleiten, damit die Adresse nie ".html" enthaelt.
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+([^\s?]+)\.html[?\s] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Intern die passende .html-Datei ausliefern, ohne die Adresse zu aendern.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>
